{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unfold",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "src/server.ts",
  "vars": {
    "HOSTED_BILLING_ENABLED": "true",
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "version_metadata": {
    "binding": "WORKER_VERSION",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unfold-production",
      "database_id": "c1c938f5-171e-4dac-a3fa-c70fd3c72b26",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILEROUTER_FILES",
      "bucket_name": "unfold-files",
    },
  ],
  "services": [
    {
      "binding": "NATIVE_PARSERS",
      "service": "unfold-native-parsers",
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "workflows": [
    {
      "name": "unfold-document",
      "binding": "DOCUMENT_WORKFLOW",
      "class_name": "DocumentWorkflow",
    },
  ],
}
